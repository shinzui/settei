cabal-version:      3.8
name:               settei-example-service
version:            0.1.0.0
synopsis:           Kubernetes-shaped reference service for Settei
description:
  Demonstrate environment-dependent defaults, production-only secrets,
  mounted configuration files, and safe startup diagnostics.

homepage:           https://github.com/shinzui/settei
bug-reports:        https://github.com/shinzui/settei/issues
license:            BSD-3-Clause
author:             shinzui
maintainer:         shinzui
category:           Configuration
build-type:         Simple
extra-source-files:
  kubernetes/*.yaml
  kubernetes/README.md
  README.md

data-files:         test/fixtures/*.yaml

source-repository head
  type:     git
  location: https://github.com/shinzui/settei.git

common common
  default-language:   GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:        -Wall -Wcompat

library
  import:          common
  hs-source-dirs:  src
  exposed-modules: Settei.Example.Service
  build-depends:
    , base                         >=4.21    && <5
    , containers                   >=0.6.8   && <0.8
    , generic-lens                 >=2.2     && <2.4
    , optparse-applicative         >=0.19    && <0.20
    , selective                    >=0.7     && <0.8
    , settei                       ==0.1.0.0
    , settei-dhall                 ==0.1.0.0
    , settei-env                   ==0.1.0.0
    , settei-kdl                   ==0.1.0.0
    , settei-optparse-applicative  ==0.1.0.0
    , settei-yaml                  ==0.1.0.0
    , text                         >=2.1     && <2.2

executable settei-example-service
  import:         common
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:
    , base                    >=4.21    && <5
    , optparse-applicative    >=0.19    && <0.20
    , settei-env              ==0.1.0.0
    , settei-example-service  ==0.1.0.0
    , text                    >=2.1     && <2.2

test-suite settei-example-service-tests
  import:          common
  type:            exitcode-stdio-1.0
  hs-source-dirs:  test
  main-is:         Main.hs
  other-modules:
    Paths_settei_example_service
    Settei.Example.ServiceTest

  autogen-modules: Paths_settei_example_service
  build-depends:
    , base                    >=4.21    && <5
    , containers              >=0.6.8   && <0.8
    , generic-lens            >=2.2     && <2.4
    , settei                  ==0.1.0.0
    , settei-env              ==0.1.0.0
    , settei-example-service  ==0.1.0.0
    , settei-yaml             ==0.1.0.0
    , tasty                   >=1.5     && <1.6
    , tasty-hunit             >=0.10.2  && <0.11
    , text                    >=2.1     && <2.2
