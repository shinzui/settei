cabal-version:      3.8
name:               settei-example-cli
version:            0.1.0.0
synopsis:           Reference command-line application for Settei
description:
  Demonstrate ordered YAML, KDL, Dhall, environment, and command-line
  configuration with static schema and redacted explanation modes.

homepage:           https://github.com/shinzui/settei
bug-reports:        https://github.com/shinzui/settei/issues
license:            BSD-3-Clause
license-file:       LICENSE
author:             shinzui
maintainer:         shinzui
category:           Configuration
build-type:         Simple
tested-with:        GHC ==9.12.4
extra-source-files: README.md
data-files:         test/fixtures/*.yaml

source-repository head
  type:     git
  location: https://github.com/shinzui/settei.git

common common
  default-language:   GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:        -Wall -Wcompat

library
  import:          common
  hs-source-dirs:  src
  exposed-modules: Settei.Example.Cli
  build-depends:
    , base                         >=4.21    && <5
    , containers                   >=0.6.8   && <0.8
    , generic-lens                 >=2.2     && <2.4
    , optparse-applicative         >=0.19    && <0.20
    , settei                       ==0.1.0.0
    , settei-env                   ==0.1.0.0
    , settei-formats               ==0.1.0.0
    , settei-optparse-applicative  ==0.1.0.0
    , text                         >=2.1     && <2.2

executable settei-example-cli
  import:         common
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:
    , base                  >=4.21    && <5
    , generic-lens          >=2.2     && <2.4
    , optparse-applicative  >=0.19    && <0.20
    , settei                ==0.1.0.0
    , settei-env            ==0.1.0.0
    , settei-example-cli    ==0.1.0.0
    , text                  >=2.1     && <2.2

test-suite settei-example-cli-tests
  import:          common
  type:            exitcode-stdio-1.0
  hs-source-dirs:  test
  main-is:         Main.hs
  other-modules:
    Paths_settei_example_cli
    Settei.Example.CliTest

  autogen-modules: Paths_settei_example_cli
  build-depends:
    , base                  >=4.21    && <5
    , generic-lens          >=2.2     && <2.4
    , optparse-applicative  >=0.19    && <0.20
    , settei                ==0.1.0.0
    , settei-env            ==0.1.0.0
    , settei-example-cli    ==0.1.0.0
    , tasty                 >=1.5     && <1.6
    , tasty-hunit           >=0.10.2  && <0.11
    , text                  >=2.1     && <2.2
