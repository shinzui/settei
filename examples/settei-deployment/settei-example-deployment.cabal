cabal-version: 3.8
name: settei-example-deployment
version: 0.2.0.0
synopsis: Deployment configuration contract reference application
description:
  Export a source-free deployment contract, then validate proposed inputs
  through distinct notification server and worker checks.

homepage: https://github.com/shinzui/settei
bug-reports: https://github.com/shinzui/settei/issues
license: BSD-3-Clause
license-file: LICENSE
author: shinzui
maintainer: shinzui
category: Configuration
build-type: Simple
tested-with: ghc ==9.12.4
extra-source-files:
  README.md

data-files:
  test/fixtures/*.yaml

source-repository head
  type: git
  location: https://github.com/shinzui/settei.git

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Wcompat

library
  import: common
  hs-source-dirs: src
  exposed-modules: Settei.Example.Deployment
  build-depends:
    base >=4.21 && <5,
    containers >=0.6.8 && <0.8,
    generic-lens >=2.2 && <2.4,
    optparse-applicative >=0.19 && <0.20,
    settei ==0.2.0.0,
    settei-env ==0.2.0.0,
    settei-optparse-applicative ==0.2.0.0,
    settei-yaml ==0.2.0.0,
    text >=2.1 && <2.2,

executable settei-example-deployment-server
  import: common
  hs-source-dirs: app/server
  main-is: Main.hs
  build-depends:
    base >=4.21 && <5,
    optparse-applicative >=0.19 && <0.20,
    settei-env ==0.2.0.0,
    settei-example-deployment ==0.2.0.0,
    text >=2.1 && <2.2,

executable settei-example-deployment-worker
  import: common
  hs-source-dirs: app/worker
  main-is: Main.hs
  build-depends:
    base >=4.21 && <5,
    optparse-applicative >=0.19 && <0.20,
    settei-env ==0.2.0.0,
    settei-example-deployment ==0.2.0.0,
    text >=2.1 && <2.2,

test-suite settei-example-deployment-tests
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    Paths_settei_example_deployment
    Settei.Example.DeploymentTest

  autogen-modules: Paths_settei_example_deployment
  build-depends:
    base >=4.21 && <5,
    containers >=0.6.8 && <0.8,
    filepath >=1.5.4 && <1.6,
    generic-lens >=2.2 && <2.4,
    optparse-applicative >=0.19 && <0.20,
    settei ==0.2.0.0,
    settei-env ==0.2.0.0,
    settei-example-deployment ==0.2.0.0,
    settei-yaml ==0.2.0.0,
    tasty >=1.5 && <1.6,
    tasty-hunit >=0.10.2 && <0.11,
    text >=2.1 && <2.2,
