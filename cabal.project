  examples/settei-cli
  settei
  settei-dhall
  settei-env
  settei-kdl
  settei-optparse-applicative
  settei-yaml

package settei
  tests: True

package settei-dhall
  tests: True

package settei-env
  tests: True

package settei-kdl
  tests: True

package settei-optparse-applicative
  tests: True

package settei-yaml
  tests: True

package settei-example-cli
  tests: True

-- dhall-json 1.7.12's Hackage revision predates bytestring 0.12. The registered
-- dhall-haskell monorepo widens the same release's source bound to <0.13, and
-- the adapter is tested against GHC 9.12's bytestring 0.12 API.
allow-newer: dhall-json:aeson, dhall-json:bytestring, dhall-json:text
